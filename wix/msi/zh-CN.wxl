  <String Id="ErrorDlgErrorText" Overridable="yes" Value="提示" />
  <String Id="ErrorDlgErrorIcon" Overridable="yes" Value="WixUI_Ico_Info" />
  <String Id="ErrorDlgErrorIconTooltip" Overridable="yes" Value="信息图标" />

  <String Id="FatalError_Title" Overridable="yes" Value="[ProductName] 安装程序" />
  <String Id="FatalErrorBitmap" Overridable="yes" Value="WixUI_Bmp_Dialog" />
  <String Id="FatalErrorTitle" Overridable="yes" Value="{\WixUI_Font_Bigger}[ProductName] 安装向导提前结束" />
  <String Id="FatalErrorDescription1" Overridable="yes" Value="由于出现错误，[ProductName] 安装向导提前结束。您的系统未做任何更改。若要在稍后安装此程序，请再次运行安装向导。" />
  <String Id="FatalErrorDescription2" Overridable="yes" Value="点击“完成”按钮退出安装向导。" />

  <String Id="UserExit_Title" Overridable="yes" Value="[ProductName] 安装程序" />
  <String Id="UserExitBitmap" Overridable="yes" Value="WixUI_Bmp_Dialog" />
  <String Id="UserExitTitle" Overridable="yes" Value="{\WixUI_Font_Bigger}[ProductName] 安装向导已中断" />
  <String Id="UserExitDescription1" Overridable="yes" Value="[ProductName] 安装已中断。您的系统未做任何更改。若要在稍后安装此程序，请重新运行安装程序。" />
  <String Id="UserExitDescription2" Overridable="yes" Value="点击“完成”按钮退出安装向导。" />

  <String Id="CancelDlg_Title" Overridable="yes" Value="[ProductName] 安装程序" />
