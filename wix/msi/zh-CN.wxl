<?xml version="1.0" encoding="UTF-8"?>
<!--
  Gemacast 安装程序简体中文本地化。
  与 WixToolset.UI 扩展的 en-US 资源逐键对应；未在此列出的键会回退到扩展默认的 en-US。
  布局约束：MSI 对话框尺寸固定，尽量保持与英文等长的措辞，避免文字溢出。
-->
<WixLocalization Culture="zh-CN"
                 Language="2052"
                 Codepage="936"
                 xmlns="http://wixtoolset.org/schemas/v4/wxl">

  <!-- ===== 通用按钮 ===== -->
  <String Id="WixUIBack" Overridable="yes" Value="上一步(&amp;B)" />
  <String Id="WixUINext" Overridable="yes" Value="下一步(&amp;N)" />
  <String Id="WixUICancel" Overridable="yes" Value="取消" />
  <String Id="WixUIFinish" Overridable="yes" Value="完成(&amp;F)" />
  <String Id="WixUIRetry" Overridable="yes" Value="重试(&amp;R)" />
  <String Id="WixUIIgnore" Overridable="yes" Value="忽略(&amp;I)" />
  <String Id="WixUIYes" Overridable="yes" Value="是(&amp;Y)" />
  <String Id="WixUINo" Overridable="yes" Value="否(&amp;N)" />
  <String Id="WixUIOK" Overridable="yes" Value="确定" />
  <String Id="WixUIPrint" Overridable="yes" Value="打印(&amp;P)" />

  <!-- ===== 字体（CustomUI.wxs 引用） ===== -->
  <String Id="Advanced_Font_Normal_Size" Overridable="yes" Value="9" />
  <String Id="Advanced_Font_Bigger_Size" Overridable="yes" Value="12" />
  <String Id="Advanced_Font_Title_Size" Overridable="yes" Value="9" />
  <String Id="Advanced_Font_Emphasized_Size" Overridable="yes" Value="9" />
  <String Id="Advanced_Font_FaceName" Overridable="yes" Value="Microsoft YaHei" />

  <!-- ===== 欢迎 ===== -->
  <String Id="WelcomeDlg_Title" Overridable="yes" Value="[ProductName] 安装程序" />
  <String Id="WelcomeDlgBitmap" Overridable="yes" Value="WixUI_Bmp_Dialog" />
  <String Id="WelcomeDlgDescription" Overridable="yes" Value="安装程序将在您的计算机上安装 [ProductName]。点击“下一步”继续，或点击“取消”退出。" />
  <String Id="WelcomeUpdateDlgDescriptionUpdate" Overridable="yes" Value="安装程序将更新您计算机上的 [ProductName]。点击“下一步”继续，或点击“取消”退出。" />
  <String Id="WelcomeDlgTitle" Overridable="yes" Value="{\WixUI_Font_Bigger}欢迎使用 [ProductName] 安装向导" />

  <!-- ===== 许可协议 ===== -->
  <String Id="LicenseAgreementDlg_Title" Overridable="yes" Value="[ProductName] 安装程序" />
  <String Id="LicenseAgreementDlgLicenseAcceptedCheckBox" Overridable="yes" Value="我接受许可协议中的条款(&amp;A)" />
  <String Id="LicenseAgreementDlgBannerBitmap" Overridable="yes" Value="WixUI_Bmp_Banner" />
  <String Id="LicenseAgreementDlgDescription" Overridable="yes" Value="请仔细阅读以下许可协议" />
  <String Id="LicenseAgreementDlgTitle" Overridable="yes" Value="{\WixUI_Font_Title}最终用户许可协议" />

  <!-- ===== 安装目录 ===== -->
  <String Id="InstallDirDlg_Title" Overridable="yes" Value="[ProductName] 安装程序" />
  <String Id="InstallDirDlgChange" Overridable="yes" Value="更改(&amp;C)…" />
  <String Id="InstallDirDlgTitle" Overridable="yes" Value="{\WixUI_Font_Title}目标文件夹" />
  <String Id="InstallDirDlgDescription" Overridable="yes" Value="点击“下一步”安装到默认文件夹，或点击“更改”选择其他位置。" />
  <String Id="InstallDirDlgBannerBitmap" Overridable="yes" Value="WixUI_Bmp_Banner" />
  <String Id="InstallDirDlgFolderLabel" Overridable="yes" Value="将 [ProductName] 安装到：" />

  <!-- ===== 浏览目录 ===== -->
  <String Id="BrowseDlg_Title" Overridable="yes" Value="[ProductName] 安装程序" />
  <String Id="BrowseDlgComboLabel" Overridable="yes" Value="查找范围(&amp;L)：" />
  <String Id="BrowseDlgWixUI_Bmp_Up" Overridable="yes" Value="WixUI_Bmp_Up" />
  <String Id="BrowseDlgWixUI_Bmp_UpTooltip" Overridable="yes" Value="向上一级" />
  <String Id="BrowseDlgNewFolder" Overridable="yes" Value="WixUI_Bmp_New" />
  <String Id="BrowseDlgNewFolderTooltip" Overridable="yes" Value="新建文件夹" />
  <String Id="BrowseDlgPathLabel" Overridable="yes" Value="文件夹名(&amp;F)：" />
  <String Id="BrowseDlgBannerBitmap" Overridable="yes" Value="WixUI_Bmp_Banner" />
  <String Id="BrowseDlgDescription" Overridable="yes" Value="浏览至目标文件夹" />
  <String Id="BrowseDlgTitle" Overridable="yes" Value="{\WixUI_Font_Title}更改目标文件夹" />

  <!-- ===== 磁盘空间 ===== -->
  <String Id="DiskCostDlg_Title" Overridable="yes" Value="[ProductName] 安装程序" />
  <String Id="DiskCostDlgBannerBitmap" Overridable="yes" Value="WixUI_Bmp_Banner" />
  <String Id="DiskCostDlgText" Overridable="yes" Value="高亮卷没有足够的磁盘空间来安装所选功能。您可以从中删除一些文件、减少安装的功能，或选择其他目标驱动器。" />
  <String Id="DiskCostDlgDescription" Overridable="yes" Value="安装所选功能所需的磁盘空间。" />
  <String Id="DiskCostDlgTitle" Overridable="yes" Value="{\WixUI_Font_Title}磁盘空间要求" />
  <String Id="DiskCostDlgVolumeList" Overridable="yes" Value="{120}{70}{70}{70}{70}" />

  <!-- ===== 准备 / 进度 / 恢复 ===== -->
  <String Id="PrepareDlg_Title" Overridable="yes" Value="[ProductName] 安装程序" />
  <String Id="PrepareDlgBitmap" Overridable="yes" Value="WixUI_Bmp_Dialog" />
  <String Id="PrepareDlgDescription" Overridable="yes" Value="请稍候，安装程序正在准备安装向导。" />
  <String Id="PrepareDlgTitle" Overridable="yes" Value="{\WixUI_Font_Bigger}欢迎使用 [ProductName] 安装向导" />

  <String Id="ProgressDlg_Title" Overridable="yes" Value="[ProductName] 安装程序" />
  <String Id="ProgressDlgBannerBitmap" Overridable="yes" Value="WixUI_Bmp_Banner" />
  <String Id="ProgressDlgTextInstalling" Overridable="yes" Value="请稍候，安装程序正在安装 [ProductName]。" />
  <String Id="ProgressDlgTitleInstalling" Overridable="yes" Value="{\WixUI_Font_Title}正在安装 [ProductName]" />
  <String Id="ProgressDlgTextChanging" Overridable="yes" Value="请稍候，安装程序正在更改 [ProductName]。" />
  <String Id="ProgressDlgTitleChanging" Overridable="yes" Value="{\WixUI_Font_Title}正在更改 [ProductName]" />
  <String Id="ProgressDlgTextRepairing" Overridable="yes" Value="请稍候，安装程序正在修复 [ProductName]。" />
  <String Id="ProgressDlgTitleRepairing" Overridable="yes" Value="{\WixUI_Font_Title}正在修复 [ProductName]" />
  <String Id="ProgressDlgTextRemoving" Overridable="yes" Value="请稍候，安装程序正在卸载 [ProductName]。" />
  <String Id="ProgressDlgTitleRemoving" Overridable="yes" Value="{\WixUI_Font_Title}正在卸载 [ProductName]" />
  <String Id="ProgressDlgTextUpdating" Overridable="yes" Value="请稍候，安装程序正在更新 [ProductName]。" />
  <String Id="ProgressDlgTitleUpdating" Overridable="yes" Value="{\WixUI_Font_Title}正在更新 [ProductName]" />
  <String Id="ProgressDlgProgressBar" Overridable="yes" Value="进度" />
  <String Id="ProgressDlgStatusLabel" Overridable="yes" Value="状态：" />

  <String Id="ResumeDlg_Title" Overridable="yes" Value="[ProductName] 安装程序" />
  <String Id="ResumeDlgInstall" Overridable="yes" Value="安装(&amp;I)" />
  <String Id="ResumeDlgBitmap" Overridable="yes" Value="WixUI_Bmp_Dialog" />
  <String Id="ResumeDlgDescription" Overridable="yes" Value="安装程序将完成 [ProductName] 的安装。点击“安装”继续，或点击“取消”退出。" />
  <String Id="ResumeDlgTitle" Overridable="yes" Value="{\WixUI_Font_Bigger}正在恢复 [ProductName] 安装向导" />

  <!-- ===== 确认安装 ===== -->
  <String Id="VerifyReadyDlg_Title" Overridable="yes" Value="[ProductName] 安装程序" />
  <String Id="VerifyReadyDlgBannerBitmap" Overridable="yes" Value="WixUI_Bmp_Banner" />
  <String Id="VerifyReadyDlgInstall" Overridable="yes" Value="安装(&amp;I)" />
  <String Id="VerifyReadyDlgInstallText" Overridable="yes" Value="点击“安装”开始安装。点击“上一步”查看或修改安装设置。点击“取消”退出向导。" />
  <String Id="VerifyReadyDlgInstallTitle" Overridable="yes" Value="{\WixUI_Font_Title}准备安装 [ProductName]" />
  <String Id="VerifyReadyDlgChange" Overridable="yes" Value="更改(&amp;C)" />
  <String Id="VerifyReadyDlgChangeText" Overridable="yes" Value="点击“更改”开始修改。点击“上一步”查看或修改安装设置。点击“取消”退出向导。" />
  <String Id="VerifyReadyDlgChangeTitle" Overridable="yes" Value="{\WixUI_Font_Title}准备更改 [ProductName]" />
  <String Id="VerifyReadyDlgRepair" Overridable="yes" Value="修复(&amp;P)" />
  <String Id="VerifyReadyDlgRepairText" Overridable="yes" Value="点击“修复”修复 [ProductName] 的安装。点击“上一步”查看或修改安装设置。点击“取消”退出向导。" />
  <String Id="VerifyReadyDlgRepairTitle" Overridable="yes" Value="{\WixUI_Font_Title}准备修复 [ProductName]" />
  <String Id="VerifyReadyDlgRemove" Overridable="yes" Value="卸载(&amp;R)" />
  <String Id="VerifyReadyDlgRemoveText" Overridable="yes" Value="点击“卸载”从计算机中移除 [ProductName]。点击“上一步”查看或修改安装设置。点击“取消”退出向导。" />
  <String Id="VerifyReadyDlgRemoveTitle" Overridable="yes" Value="{\WixUI_Font_Title}准备卸载 [ProductName]" />
  <String Id="VerifyReadyDlgUpdate" Overridable="yes" Value="更新(&amp;U)" />
  <String Id="VerifyReadyDlgUpdateText" Overridable="yes" Value="点击“更新”更新 [ProductName]。点击“上一步”查看或修改安装设置。点击“取消”退出向导。" />
  <String Id="VerifyReadyDlgUpdateTitle" Overridable="yes" Value="{\WixUI_Font_Title}准备更新 [ProductName]" />

  <!-- ===== 维护 ===== -->
  <String Id="MaintenanceWelcomeDlg_Title" Overridable="yes" Value="[ProductName] 安装程序" />
  <String Id="MaintenanceWelcomeDlgBitmap" Overridable="yes" Value="WixUI_Bmp_Dialog" />
  <String Id="MaintenanceWelcomeDlgDescription" Overridable="yes" Value="安装向导可让您更改 [ProductName] 的安装方式，或将其从计算机中移除。点击“下一步”继续，或点击“取消”退出。" />
  <String Id="MaintenanceWelcomeDlgTitle" Overridable="yes" Value="{\WixUI_Font_Bigger}欢迎使用 [ProductName] 安装向导" />

  <String Id="MaintenanceTypeDlg_Title" Overridable="yes" Value="[ProductName] 安装程序" />
  <String Id="MaintenanceTypeDlgChangeButton" Overridable="yes" Value="更改(&amp;C)" />
  <String Id="MaintenanceTypeDlgChangeButtonTooltip" Overridable="yes" Value="更改安装" />
  <String Id="MaintenanceTypeDlgRepairButton" Overridable="yes" Value="修复(&amp;P)" />
  <String Id="MaintenanceTypeDlgRepairButtonTooltip" Overridable="yes" Value="修复安装" />
  <String Id="MaintenanceTypeDlgRemoveButton" Overridable="yes" Value="卸载(&amp;R)" />
  <String Id="MaintenanceTypeDlgRemoveButtonTooltip" Overridable="yes" Value="卸载程序" />
  <String Id="MaintenanceTypeDlgBannerBitmap" Overridable="yes" Value="WixUI_Bmp_Banner" />
  <String Id="MaintenanceTypeDlgDescription" Overridable="yes" Value="请选择要执行的操作。" />
  <String Id="MaintenanceTypeDlgTitle" Overridable="yes" Value="{\WixUI_Font_Title}更改、修复或卸载安装" />
  <String Id="MaintenanceTypeDlgChangeText" Overridable="yes" Value="更改功能的安装方式。" />
  <String Id="MaintenanceTypeDlgChangeDisabledText" Overridable="yes" Value="[ProductName] 没有可单独选择的功能。" />
  <String Id="MaintenanceTypeDlgRemoveText" Overridable="yes" Value="从计算机中移除 [ProductName]。" />
  <String Id="MaintenanceTypeDlgRemoveDisabledText" Overridable="yes" Value="[ProductName] 无法卸载。" />
  <String Id="MaintenanceTypeDlgRepairText" Overridable="yes" Value="通过修复缺失或损坏的文件、快捷方式和注册表项，修复最近一次安装中的错误。" />
  <String Id="MaintenanceTypeDlgRepairDisabledText" Overridable="yes" Value="[ProductName] 无法修复。" />

  <!-- ===== 完成 ===== -->
  <String Id="ExitDialog_Title" Overridable="yes" Value="[ProductName] 安装程序" />
  <String Id="ExitDialogBitmap" Overridable="yes" Value="WixUI_Bmp_Dialog" />
  <String Id="ExitDialogDescription" Overridable="yes" Value="点击“完成”按钮退出安装向导。" />
  <String Id="ExitDialogTitle" Overridable="yes" Value="{\WixUI_Font_Bigger}[ProductName] 安装向导已完成" />

  <!-- ===== 错误 / 中断 ===== -->
