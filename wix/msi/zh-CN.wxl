  <String Id="FilesInUseExit" Overridable="yes" Value="退出(&amp;X)" />
  <String Id="FilesInUseBannerBitmap" Overridable="yes" Value="WixUI_Bmp_Banner" />
  <String Id="FilesInUseText" Overridable="yes" Value="以下程序正在使用需要由本次安装更新的文件。请关闭这些程序，然后点击“重试”继续安装，或点击“退出”结束安装。" />
