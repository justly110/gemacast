  <String Id="FilesInUseTitle" Overridable="yes" Value="{\WixUI_Font_Title}正在使用的文件" />

  <String Id="MsiRMFilesInUse_Title" Overridable="yes" Value="[ProductName] 安装程序" />
  <String Id="MsiRMFilesInUseBannerBitmap" Overridable="yes" Value="WixUI_Bmp_Banner" />
  <String Id="MsiRMFilesInUseText" Overridable="yes" Value="以下程序正在使用需要由本次安装更新的文件。您可以让安装程序关闭它们并尝试重新启动，或稍后重启计算机。" />
  <String Id="MsiRMFilesInUseDescription" Overridable="yes" Value="需要更新的某些文件当前正在使用中。" />
